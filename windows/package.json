{
  "name": "retto-windows",
  "productName": "Retto",
  "version": "0.12.1-beta.1",
  "description": "Retto desk pet for Windows (beta)",
  "author": "luxia yoon",
  "license": "MIT",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "skins": "node scripts/export-skins.mjs",
    "dist": "electron-builder --win zip --x64 --arm64"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.rehyundesign.retto",
    "productName": "Retto",
    "directories": { "output": "../dist/windows" },
    "files": ["src/**/*", "package.json"],
    "extraResources": [
      { "from": "../assets", "to": "assets", "filter": ["spritesheet.webp", "NanumMiNiSonGeurSsi.ttf", "LICENSE.md", "icon.png"] },
      { "from": "../hook", "to": "hook", "filter": ["hook.cjs", "install.cjs", "lib/**/*", "package.json"] },
      { "from": "skins", "to": "skins", "filter": ["**/*"] }
    ],
    "win": { "icon": "../assets/icon.png", "artifactName": "Retto-${version}-windows-${arch}.${ext}" }
  }
}
